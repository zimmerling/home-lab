# Example terraform.tfvars file
# Copy this to terraform.tfvars and fill in your values
# Note: terraform.tfvars is gitignored and should NEVER be committed

# Node IP Addresses (fill these in after Talos installation)
# Initially use local IPs (192.168.x.x), then switch to Tailscale IPs after nodes join
controlplane_host = ""  # e.g., "192.168.178.50" (initial) or "100.98.178.59" (Tailscale)
worker_host       = ""  # e.g., "192.168.178.51" (initial) or "100.98.178.60" (Tailscale)

# Cluster Configuration
cluster_name = "homelab"

# Talos and Kubernetes Versions
talos_version      = "v1.9.0"
kubernetes_version = "1.31.1"

# Talos Factory Schematic ID (generated from https://factory.talos.dev)
# Includes Tailscale extension - see docs/talos-schematic.md for generation steps
talos_schematic_id = ""  # e.g., "077514df2c1b6436460bc60faabc976687b16193b8a1290fda4366c69024fec2"

# Storage Configuration
synology_iscsi_target = "iqn.2025-09.homelab.local:k8s-storage"
synology_iscsi_portal = "100.98.178.58:3260"

# Secrets (DO NOT fill here - will be injected from Bitwarden via GitHub Actions)
# For local testing, set via environment:
#   export TF_VAR_tailscale_authkey="tskey-auth-..."
#   export TF_VAR_iscsi_chap_username="k8suser"
#   export TF_VAR_iscsi_chap_password="..."
# tailscale_authkey = ""
# iscsi_chap_username = ""
# iscsi_chap_password = ""
